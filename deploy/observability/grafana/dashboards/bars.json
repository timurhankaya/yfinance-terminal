        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "intraday scope at risk",
      "description": "1m reaches back 29 days, 5m and 15m 59, 60m 729. A symbol whose newest bar is older than that can never be filled.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yfin-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yfin-prometheus"
          },
          "expr": "yfin_intraday_scope_stale",
          "refId": "A",
          "legendFormat": "{{interval}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
