    {
      "type": "stat",
      "title": "relays",
      "description": "0 is normal: both relays are off unless Kafka publishing is on.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yfin-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yfin-prometheus"
          },
          "expr": "sum(up{job=\"yfin-relays\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
