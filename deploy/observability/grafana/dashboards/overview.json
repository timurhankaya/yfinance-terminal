{
  "uid": "yfin-overview",
  "id": null,
  "title": "yfin / Overview",
  "description": "Is anything broken, and is the data current. Every panel here answers a question an operator has before they know what they are looking for. A relay or the observability profile being off shows as `down` and is not alerted -- both are opt-in.",
  "tags": [
    "yfin",
    "overview"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "scheduler",
      "description": "The one target whose absence blanks everything else: it carries the job metrics AND every gauge read from a table.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yfin-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yfin-prometheus"
          },
          "expr": "up{job=\"yfin-scheduler\"}",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "api",
      "description": "",
      "gridPos": {
        "x": 4,
        "y": 0,
