    },
    {
      "type": "table",
      "title": "errors by kind",
      "description": "`error_kind`, not the message: grouping a dashboard by free text gives one bucket per Yahoo error string. `unknown` is a failure nothing classified.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
