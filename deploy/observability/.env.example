# Credentials for the monitoring containers, not yfin settings (the root
# .env.example is tested against the Settings fields). Copy to `.env` next
# to this file. They arrive through compose's `env_file`, which does not
# feed `${...}` interpolation, so the compose file never references them.

# Grafana's admin login. No default: a dashboard behind `admin/admin` is a
# dashboard published to anyone who can reach the port.
GF_SECURITY_ADMIN_PASSWORD=

# The read-only role `yfin db monitor-role --password-env MONITOR_DB_PASSWORD`
# creates. It holds `pg_monitor` and no SELECT on the data tables: an
# exporter that could read `symbols` would be a second copy of the
# warehouse behind a Grafana login.
MONITOR_DB_PASSWORD=

# Where alerts go. A webhook rather than SMTP -- a mail relay is a second
# thing to configure, to authenticate and to notice has stopped working.
# Slack and Discord incoming hooks both accept this shape.
GRAFANA_ALERT_WEBHOOK=

# How long `docker stop` waits for the scheduler. Must stay ABOVE the
# scheduler's own `yf_schedule_stop_grace_seconds` (600 by default), or
# Docker SIGKILLs a sync that is still holding the advisory lock and the
# next run finds it held. Read from the shell or the ROOT .env, because
# compose interpolates this one.
SCHEDULER_STOP_GRACE=620s
