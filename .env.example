# --- database (env-only) ---------------------------------------------------
# These six, plus LOG_LEVEL, LOG_FORMAT, METRICS_PORT and YF_PROXY_SECRET_KEY
# below, are the ONLY
# settings that cannot be managed from the database: reading the settings
# table requires a connection, and the connection is what they configure.
# Everything else in this file is DB-managed and overridable at runtime --
# `yfin config list` is the authoritative list, this file is a starting point.
DB_HOST=localhost
DB_PORT=5432
DB_USER=yfin
DB_PASSWORD=
DB_NAME=yfinance
DB_TEST_NAME=yfinance_test

# --- fetch behaviour -------------------------------------------------------
YF_RATE_LIMIT_PER_SEC=2
YF_MAX_WORKERS=4
YF_QUEUE_MAXSIZE=8

# Retry (tenacity): attempt count and the exponential backoff bounds.
YF_RETRY_ATTEMPTS=5
YF_RETRY_INITIAL_SEC=1
YF_RETRY_MAX_SEC=16

# news dataset
YF_NEWS_COUNT=50
YF_NEWS_TAB=all

# Overlap on incremental fetches, so a backdated correction is not missed.
YF_INCREMENTAL_OVERLAP_DAYS=7
# Consecutive unknown_symbol results before is_active=0. Data is not deleted.
YF_DELIST_THRESHOLD=5

LOG_LEVEL=INFO
# `console` on a TTY, `json` otherwise. Env-only for the same reason as
# LOG_LEVEL: the format is decided before the first line, which is before
# any database exists.
LOG_FORMAT=
# The /metrics port for THIS process. 0 = off, which is the default
# everywhere; the observability compose override gives each service its own
# (scheduler 9101, stream 9102, the two relays 9103 and 9104). It cannot be
# a database setting -- one value would bind five services to one port.
METRICS_PORT=0

# --- sharded runs (proxy pool) ---------------------------------------------
YF_MAX_SHARDS=4
YF_SHARD_TIMEOUT_SECONDS=3600
YF_TXN_RETRY_ATTEMPTS=3

# --- proxy policy ----------------------------------------------------------
YF_PROXY_COOLDOWN_SECONDS=900
YF_PROXY_FAILURE_THRESHOLD=3
YF_PROXY_DEAD_ROUNDS=3
YF_PROXY_CHECK_TIMEOUT=10
# Fernet key. While empty, a proxy WITH A PASSWORD CANNOT BE ADDED. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YF_PROXY_SECRET_KEY=

# --- yfinance advanced -----------------------------------------------------
# The tz/cookie/ISIN cache is SQLite; each shard gets its own subdirectory,
# because N processes writing one SQLite file corrupt it.
YF_TZ_CACHE_DIR=.cache/yfinance
YF_HISTORY_REPAIR=true
YF_EARNINGS_DATES_MAX_PAGES=3
YF_MARKET_REGIONS=US,EUROPE,ASIA,GB,CURRENCIES,CRYPTOCURRENCIES,COMMODITIES,RATES
YF_CALENDAR_LOOKBACK_DAYS=7
YF_CALENDAR_LOOKAHEAD_DAYS=30
YF_CALENDAR_PAGE_LIMIT=100
YF_CALENDAR_MAX_PAGES=5
# Pruning is OFF BY DEFAULT: a deleted calendar/_history row cannot be
# brought back.
YF_PRUNE_ENABLED=false

# --- price_bars ------------------------------------------------------------
# Interval selection does NOT come from .env: `--datasets bars` expands to all
# six intervals, `intraday` to four, and a single name works too
# (`--datasets bars_5m`). Which SYMBOLS 1m covers lives in the
# `intraday_scope` table (`yfin scope add`), not in configuration.

# Whether extended-session (pre/post) bars are written. NOTE: extra bars are
# not a US-only phenomenon -- SHEL.L and VWCE.DE report
# hasPrePostMarketData=False and still return 5 and 8 extra bars (measured).
# Turning this off loses those bars PERMANENTLY: Yahoo stops serving 1m after
# 29 days and the other intervals after 59.
YF_BAR_PREPOST=true

# Backward overlap on the incremental window. The overlap is idempotent
# (measured: 78 shared bars, no value differences); it costs a few hundred
# redundant upserts and buys not missing the bar at the session boundary.
YF_BAR_OVERLAP_DAYS=2

# --- discovery, screener, streaming ----------------------------------------
# Deliberately not listed key by key: these are DB-managed, they change more
# often than this file does, and an out-of-date list here is worse than no
# list. `yfin config list` prints every setting with its effective value and
# where that value came from; `yfin config set <key> <value>` changes one
# without a restart.

# --- read API (env-only) -----------------------------------------------------
# All twelve of these are env-only, and unlike the pipeline settings that is
# not a choice about secrecy: `ApiSettings` has no `settings` table behind it
# and no `yfin config` command, deliberately (api/core/config.py -- an operator
# changing `yf_max_shards` from the admin panel has no business changing the
# JWT audience). This file is the only place they can be learned from.

# REQUIRED. The API refuses to mint a token without it, and it is checked
# where it is used rather than at startup, so a deployment missing it comes up
# healthy and then fails every /oauth/token call. At least 32 bytes -- below
# that an HS256 key is weaker than the digest it feeds.
#   openssl rand -base64 48
YFAPI_JWT_SIGNING_KEY=

# Key id published in the JWT header, so a second key can be rotated in
# before the first is retired.
YFAPI_JWT_KID=k1
YFAPI_JWT_ISSUER=yfin-api
YFAPI_JWT_AUDIENCE=yfin-api
# 60..3600. Short on purpose: a leaked token expires on its own, and the
# client-credentials flow makes renewal free.
YFAPI_TOKEN_TTL_SECONDS=900

# Rate limits, quotas, concurrency slots and revocation all live here. The
# API does not start without a reachable Redis.
YFAPI_REDIS_URL=redis://localhost:6379/0

# CIDR list. EMPTY MEANS "no reverse proxy": X-Forwarded-For is then ignored
# entirely rather than trusted blindly, so the rate limiter sees the real peer.
# Set it only when something in front actually terminates TLS.
YFAPI_TRUSTED_PROXIES=

# Comma-separated origins for browser callers. Empty disables CORS.
YFAPI_CORS_ORIGINS=

# Serves /docs and /redoc. Turning it off does NOT stop the application from
# being the one the committed openapi.json describes; it only withholds the
# pages.
YFAPI_DOCS_ENABLED=true

# The base URL this deployment answers on, published as the first `servers`
# entry. EMPTY MEANS the constant in core/openapi.py, which is what the
# committed openapi.json carries -- leave it empty unless this deployment
# really is reachable somewhere else, or the document will differ by whose
# machine generated it.
YFAPI_PUBLIC_BASE_URL=

# /health/ready caches its dependency probe for this many seconds, and the
# health endpoints are limited separately from the metered surface: a
# monitoring agent polling every second must not consume a client's quota.
YFAPI_HEALTH_CACHE_SECONDS=5
YFAPI_HEALTH_RATE_LIMIT_PER_MINUTE=60

# Web terminal (the browser UI under /ui). Off by default. Switching it
# on publishes the terminal to anyone who can reach the port: there is no
# login, and the page reads the archive through its own unmetered mount
# at /ui/api/v1.
YFAPI_UI_ENABLED=false
# Per client IP, per process, over everything under /ui/api -- the only
# thing in front of the terminal. Behind a reverse proxy this needs
# YFAPI_TRUSTED_PROXIES, or every browser shares one bucket.
YFAPI_UI_REQUESTS_PER_MINUTE=600
# The admin page at /admin (settings table, proxy pool, screens, API
# clients). Off while empty. HTTP Basic with this as the secret; put it
# behind TLS.
YFAPI_ADMIN_PASSWORD=
