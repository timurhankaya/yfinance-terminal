# --- veritabani ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=yfin
DB_PASSWORD=
DB_NAME=yfinance
DB_TEST_NAME=yfinance_test

# MySQL. DB_HOST 'localhost'tur, '127.0.0.1' degil: bu makinede
# 127.0.0.1:3306'i ayri bir yerel MySQL (9.3.0) dinliyor; hedef Docker
# container (8.3.0) yalnizca ::1 uzerinden erisilebiliyor. Dogrulama:
# SELECT VERSION() -> 8.3.0

# Cekim davranisi
YF_RATE_LIMIT_PER_SEC=2
YF_MAX_WORKERS=4
YF_QUEUE_MAXSIZE=8

# Retry (tenacity): deneme sayisi ve exponential backoff sinirlari
YF_RETRY_ATTEMPTS=5
YF_RETRY_INITIAL_SEC=1
YF_RETRY_MAX_SEC=16

# news dataset'i
YF_NEWS_COUNT=50
YF_NEWS_TAB=all

# Incremental cekimde geriye donuk duzeltmeleri yakalayan ortusme
YF_INCREMENTAL_OVERLAP_DAYS=7
# Ardisik kac unknown_symbol'den sonra is_active=0 (S8.8)
YF_DELIST_THRESHOLD=5

LOG_LEVEL=INFO

# --- shard'li calistirma (proxy havuzu) ---
YF_MAX_SHARDS=4
YF_SHARD_TIMEOUT_SECONDS=3600
YF_TXN_RETRY_ATTEMPTS=3

# --- proxy politikasi ---
YF_PROXY_COOLDOWN_SECONDS=900
YF_PROXY_FAILURE_THRESHOLD=3
YF_PROXY_DEAD_ROUNDS=3
YF_PROXY_CHECK_TIMEOUT=10
# Fernet anahtari; bossa parolali proxy EKLENEMEZ. Uretmek icin:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YF_PROXY_SECRET_KEY=

# --- yfinance advanced ---
# tz/cookie/ISIN cache'i SQLite'tir; her shard kendi alt dizinini alir
YF_TZ_CACHE_DIR=.cache/yfinance
YF_HISTORY_REPAIR=true
YF_EARNINGS_DATES_MAX_PAGES=3
YF_MARKET_REGIONS=US,EUROPE,ASIA,GB,CURRENCIES,CRYPTOCURRENCIES,COMMODITIES,RATES
YF_CALENDAR_LOOKBACK_DAYS=7
YF_CALENDAR_LOOKAHEAD_DAYS=30
YF_CALENDAR_PAGE_LIMIT=100
YF_CALENDAR_MAX_PAGES=5
# Budama VARSAYILAN KAPALI: silinen takvim/_history satiri geri getirilemez
YF_PRUNE_ENABLED=false

YF_PROBE_SUSTAINABILITY=0
# --- price_bars (PB S11) ---------------------------------------------------
# Interval secimi .env'den YAPILMAZ: `--datasets bars` alti interval'e,
# `intraday` dordune genisler; tekil ad da verilebilir (`--datasets
# bars_5m`). 1m'in SEMBOL kapsami intraday_scope tablosundadir
# (`yfin scope add`), konfigurasyonda degil.

# Seans disi (pre/post) barlar yazilsin mi. DIKKAT: ek bar yalniz ABD
# hisselerinde gelmez - SHEL.L ve VWCE.DE hasPrePostMarketData=False
# bildirdikleri halde 5 ve 8 ek bar donduruyor (olculdu). Kapatmak, o
# barlari KALICI olarak kaybetmek demektir: 1m'de 29, digerlerinde 59
# gun sonra Yahoo onlari artik vermez.
YF_BAR_PREPOST=true

# Artimli pencerede geriye ortusme. Ortusme idempotenttir (olculdu: 78
# ortak barda deger farki yok); maliyeti birkac yuz gereksiz upsert,
# faydasi seans sinirindaki barin kacmamasi.
YF_BAR_OVERLAP_DAYS=2
