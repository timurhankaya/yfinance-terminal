  "info": {
    "description": "Read-only access to the yfin market data warehouse. Authenticate with the OAuth2 client credentials flow.",
    "title": "yfin Data API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Answers whether the process is up. Touches nothing else, so it\nstays truthful while dependencies are down.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "meta"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "meta"
        ]
      }
    },
    "/oauth/token": {
      "post": {
        "operationId": "issue_token_oauth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_token_oauth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "invalid_request | unsupported_grant_type | invalid_scope"
          },
          "401": {
            "description": "invalid_client"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "too many attempts"
          },
          "503": {
            "description": "authentication temporarily unavailable"
          }
        },
        "summary": "Issue an access token",
        "tags": [
          "oauth"
        ]
      }
    },
    "/v1/datasets": {
      "get": {
        "description": "What this token can read, by default.\n\nFiltering to the caller's scopes is the default because advertising\ndata they cannot fetch is noise. `?all=true` is the documented way to\nsee the rest -- a deliberate choice, not an accident of implementation.",
