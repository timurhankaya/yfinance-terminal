esCount":6,"marketCap":{"fmt":"1.692T","longFmt":"1,692,394,848,256","raw":1692394848256},"marketWeight":{"fmt":"1.91%","raw":0.019064242},"messageBoardId":"INDEXYH207"},"performance":{"fiveYearChangePercent":{"fmt":"35.39%","raw":0.35385445},"oneYearChangePercent":{"fmt":"9.72%","raw":0.097154},"regMarketChangePercent":{"fmt":"0.82%","raw":0.008207723},"threeYearChangePercent":{"fmt":"47.54%","raw":0.47541532},"ytdChangePercent":{"fmt":"4.98%","raw":0.049794845}},"performanceOverviewBenchmark":{"fiveYearChangePercent":{"fmt":"70.97%","raw":0.70974094},"name":"S&P 500","oneYearChangePercent":{"fmt":"19.85%","raw":0.1984753},"regMarketChangePercent":{"fmt":"-0.25%","raw":-0.0025336235},"threeYearChangePercent":{"fmt":"71.14%","raw":0.7113538},"ytdChangePercent":{"fmt":"12.06%","raw":0.120622225}},"researchReports":[{"headHtml":"Analyst Report: CenterPoint Energy Inc","id":"ARGUS_2852_AnalystReport_1788454573000","investmentRating":"Neutral","provider":"Argus Research","reportDate":"2026-09-03T16:56:13Z","reportTitle":"CenterPoint Energy Inc. is a gas and electric company. The company is headquartered in gas-rich Texas and has 7 million gas customers with regulated service in Indiana, Minnesota, Ohio, and Texas. CenterPoint Energy has distribution and electric transmission operations with about 2.9 electric customers in Houston and Southwestern Indiana. Its Indiana utility has a relatively small generation capacity of about 1.3 GW. CNP has about 4.7 GW of total energy output. Its fuel mix remains heavily reliant on fossil fuels, with almost 85% of its Indiana generation from coal. The company has closed two coal-fired plants and operates one remaining coal plant in Indiana, with plans to convert the remaining plant to natural gas by 2027. CNP projects renewable sources will provide 80% of generation by 2030. \r\n\r\nRevenues in 2025 were $9.36 billion, of which about 52% were electric revenues and 48% were gas revenues. The shares are a component of the S&P 500, and the current market cap is about $26 billion.","reportType":"Analyst Report","targetPriceStatus":"Maintained"},{"headHtml":"Market Update: CNP, AVGO","id":"ARGUS_48130_MarketUpdate_1788453673000","provider":"Argus Research","reportDate":"2026-09-03T16:41:13Z","reportTitle":"The major indices are higher at midday. Wall Street continues to monitor the bond market and the stability of yields. A consensus is growing that interest rates are heading higher. Also on the watch list, the August nonfarm payrolls report is due out tomorrow morning. Crude oil continues to rise and is at $92 per barrel. The yield on the 10-year note is at 4.76%.","reportType":"Market Update"},{"headHtml":"Analyst Report: PG&E Corporation","id":"MS_0P0000045R_AnalystReport_1788375820000","investmentRating":"Bullish","provider":"Morningstar","reportDate":"2026-09-02T19:03:40Z","reportTitle":"PG&E is a holding company whose main subsidiary is Pacific Gas and Electric, a regulated utility operating in Central and Northern California that serves 5.7 million electricity customers and 4.6 million gas customers in 47 of the state's 58 counties. PG&E operated under bankruptcy court supervision in 2001-04 during California's energy crisis and in 2019-20 due to wildfire losses. In 2004, PG&E sold its unregulated assets as part of its first postbankruptcy reorganization. ","reportType":"Analyst Report","targetPrice":20.5,"targetPriceStatus":"Maintained"},{"headHtml":"Analyst Report: American Electric Power Co Inc","id":"ARGUS_2684_AnalystReport_1788373342000","investmentRating":"Bullish","provider":"Argus Research","reportDate":"2026-09-02T18:22:22Z","reportTitle":"American Electric Power is one of the largest electric companies in the U.S. AEP is 95% regulated with generation, transmission, and distribution operations and relatively small gas operations. The company's eight vertically integrated utilities and distribution utilities deliver electricity to more than 5.6 million customers in 11 states in the Midwest and Southeast. AEP has about 31 GW of generating capacity and 252,000 distribution lines. AEP also owns the nation's largest electricity transmission system, with 40,000 system miles. \r\n\r\nThe company had been under strategic review of its energy business, which ended in 2024 with AEP also announcing new leadership. AEP also exited the competitive generating business in 2023, but still has wholesale electricity operations. AEP has one nuclear generating plant, and its owned generation mix is about 38% coal, 8% nuclear, 26% natural gas, and 9% renewables. While still heavily reliant on coal, the company is expanding its use of renewable energy with investments in wind generation. Its current renewable generation capacity is 6,000 MW and the company plans to have renewables and storage providing 50% of its capacity by 2033.\r\n\r\nRevenues in 2025 were $21.9 billion, with vertical utilities accounting for about 58%. The company's largest vertical utility subsidiary based on revenues is Appalachian Power, which reported $4.2 billion in 2025. AEP has a record of consistent dividend growth and a market cap of about $66.7 billion.","reportType":"Analyst Report","targetPrice":140.0,"targetPriceStatus":"Maintained"}],"symbol":"^YH207","topCompanies":[{"lastPrice":{"fmt":"83.56","raw":83.5591},"marketCap":{"fmt":"174.302B","longFmt":"174,302,456,110","raw":174302456110},"marketWeight":{"fmt":"11.35%","raw":0.113545164},"name":"NextEra Energy, Inc.","rating":"Buy","regMarketChangePercent":{"fmt":"-0.60%","raw":-0.005959126},"symbol":"NEE","targetPrice":{"fmt":"98.39","raw":98.3889},"ytdReturn":{"fmt":"4.08%","raw":0.0408}},{"lastPrice":{"fmt":"295.38","raw":295.3782},"marketCap":{"fmt":"104.655B","longFmt":"104,654,677,395","raw":104654677395},"marketWeight":{"fmt":"6.82%","raw":0.06817479},"name":"Constellation Energy Corporation","rating":"Buy","regMarketChangePercent":{"fmt":"3.62%","raw":0.036241672},"symbol":"CEG","targetPrice":{"fmt":"348.30","raw":348.304},"yt