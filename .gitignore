# Playwright's local run: the browsers it downloads and what a failed
# run leaves behind. The E2E suite is a local acceptance criterion, not
# a CI job (web/playwright.config.ts says why).
web/test-results/
web/playwright-report/

# Agent workflow scratch: task briefs, review diffs and reports written
# by the SDD tooling. Per run, not per project -- the decisions that
# survive a run are in docs/superpowers/, which IS committed.
.superpowers/

# Vitest caches here when a bench is run from the repo root.
node_modules/
